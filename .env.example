# Local Direct ESP32 WebSocket (used when running locally over HTTP)
VITE_ESP32_WS_URL=ws://192.168.31.194:8080/ws

# Production Secure Cloud Relay (Render.com)
# Point this to your deployed relay server (e.g., wss://vishal-done-backup.onrender.com/ws)
VITE_SECURE_RELAY_URL=wss://vishal-done-backup.onrender.com/ws

# Secure Relay Authentication Token (must match RELAY_TOKEN on the relay server)
VITE_RELAY_TOKEN=saeindia_sec_99348a7b1c0e

# Default Drone Telemetry Wi-Fi Network SSID
VITE_WIFI_SSID=drone123
